# Copy to .env for local development. In production use systemd EnvironmentFile.
RUSTBB_BIND=127.0.0.1:8080
RUSTBB_BASE_URL=http://localhost:8080
RUSTBB_DATABASE_PATH=./rustbb.db
RUSTBB_SITE_NAME=RustBB
RUSTBB_LOG=info,tower_http=info

# OPEN | INVITE | CLOSED
RUSTBB_REGISTRATION=INVITE

# Set to 1 only when running behind Nginx or Caddy that sets X-Forwarded-*.
RUSTBB_TRUST_PROXY=0

# Telegram Login Widget. Create a bot with @BotFather, then /setdomain.
RUSTBB_TELEGRAM_BOT_TOKEN=
RUSTBB_TELEGRAM_BOT_USERNAME=

# Telegram numeric id that becomes administrator on first login.
RUSTBB_ADMIN_TELEGRAM_ID=

# Session lifetime in days.
RUSTBB_SESSION_DAYS=30

# Set to 0 to hide the RustBB version in the page footer.
RUSTBB_SHOW_VERSION=1

# Debug builds only: enables /dev/login, which accepts any Telegram id.
RUSTBB_DEV_LOGIN=1
